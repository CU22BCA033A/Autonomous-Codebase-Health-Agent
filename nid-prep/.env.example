# Supabase (Project Settings → API). Anon key is safe in the browser; service role is server-only.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional AI critique. Default "none" = zero cost; feedback comes from self-assessment + mentor.
# Options: none | gemini | groq | anthropic
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
# Hard cap on AI calls per day (protects free-tier quotas).
AI_DAILY_CALL_CAP=20
